;; Scoped bb.edn for the open-ot orchestrator clj/cljc port (ADR-2606280030).
;; The cljc ports use only babashka built-ins (cheshire, java.* interop) — no
;; langgraph-clj / langchain-clj dep is needed because the LangGraph demos are
;; NOT ported (they are wasmtime + LangGraph bound; kept as `.py`). Repo-root
;; bb.edn is intentionally untouched.
{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ba75f68e357109686ade80025438051df7eb21ad"
         :deps/root "lib/kotoba.error"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ba75f68e357109686ade80025438051df7eb21ad"
         :deps/root "lib/kotoba.bytes"}}
 :tasks
 {test {:doc  "Run the clojure.test suite (wasm-free subset)."
        :task (apply clojure.core/load-file ["run_tests.clj"])}}}
